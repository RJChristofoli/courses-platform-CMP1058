generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  student
  instructor
}

enum ProgressStatus {
  Completed  @map("Concluido")
  InProgress @map("Em andamento")

  @@map("ProgressStatus")
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  expired
}

model User {
  id             Int              @id @default(autoincrement())
  fullName       String
  email          String           @unique
  passwordHash   String
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  role           UserRole
  courses        Course[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  certificates   Certificate[]
  subscriptions  Subscription[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  courses     Course[]
  tracks      Track[]

  @@map("categories")
}

model Course {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  instructorId Int
  categoryId   Int
  level        String
  publishedAt  DateTime      @db.Timestamptz(3)
  instructor   User          @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modules      Module[]
  trackCourses TrackCourse[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([instructorId])
  @@index([categoryId])
  @@map("courses")
}

model Module {
  id       Int      @id @default(autoincrement())
  courseId Int
  title    String
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, order])
  @@map("modules")
}

model Lesson {
  id              Int              @id @default(autoincrement())
  moduleId        Int
  title           String
  contentType     String
  contentUrl      String
  durationMinutes Int
  order           Int
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@index([moduleId, order])
  @@map("lessons")
}

model Track {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  trackCourses TrackCourse[]
  certificates Certificate[]

  @@index([categoryId])
  @@map("tracks")
}

model TrackCourse {
  id       Int    @id @default(autoincrement())
  trackId  Int
  courseId Int
  order    Int
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([trackId, courseId])
  @@index([trackId, order])
  @@index([courseId])
  @@map("trackCourses")
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    Int
  enrolledAt  DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          Int            @id @default(autoincrement())
  userId      Int
  lessonId    Int
  completedAt DateTime?      @db.Timestamptz(3)
  status      ProgressStatus
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lessonProgress")
}

model Certificate {
  id               Int      @id @default(autoincrement())
  userId           Int
  courseId         Int
  trackId          Int?
  verificationCode String   @unique
  issuedAt         DateTime @default(now()) @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  track            Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([trackId])
  @@map("certificates")
}

model Plan {
  id             Int            @id @default(autoincrement())
  name           String
  description    String
  price          Decimal        @db.Decimal(12, 2)
  durationMonths Int
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id        Int                @id @default(autoincrement())
  userId    Int
  planId    Int
  startDate DateTime           @db.Timestamptz(3)
  endDate   DateTime           @db.Timestamptz(3)
  status    SubscriptionStatus
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@index([userId])
  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                   Int          @id @default(autoincrement())
  subscriptionId       Int
  amountPaid           Decimal      @db.Decimal(12, 2)
  paymentDate          DateTime     @db.Timestamptz(3)
  paymentMethod        String
  gatewayTransactionId String       @unique
  subscription         Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("payments")
}
